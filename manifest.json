{
  "manifest_version": 3,
  "name": "Will I Finish It?",
  "version": "1.0",
  "description": "A Chrome extension that predicts whether you'll finish a book",
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.com.au/*"
  ],
  "content_scripts": [
    {
      "js": [
        "scripts/scrapeBookData.js",
        "scripts/content.js"
      ],
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.au/*"
      ]
    }
  ]
}