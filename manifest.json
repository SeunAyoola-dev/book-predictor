{
  "manifest_version": 3,
  "name": "Will I Finish It?",
  "version": "1.0",
  "description": "A Chrome extension that predicts whether you'll finish a book",
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "activeTab"
  ]
}